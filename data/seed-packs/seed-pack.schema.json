{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashes-between-us.local/schema/seed-pack.schema.json",
  "title": "Ashes Between Us Seed Pack",
  "type": "object",
  "required": ["packId", "version", "avatars"],
  "properties": {
    "packId": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "avatars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["avatarId", "scenarios"],
        "properties": {
          "avatarId": {
            "type": "string",
            "enum": [
              "scout",
              "medic",
              "engineer",
              "guardian",
              "diplomat",
              "scavenger"
            ]
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "setting",
                "futureMsg",
                "imageUrl",
                "choices"
              ],
              "properties": {
                "id": { "type": "string", "minLength": 2 },
                "title": { "type": "string", "minLength": 3 },
                "setting": { "type": "string", "minLength": 3 },
                "message": { "type": "string" },
                "futureMsg": { "type": "string", "minLength": 3 },
                "futureSelfMessage": { "type": "string" },
                "imageUrl": { "type": "string", "minLength": 1 },
                "progressionBand": {
                  "type": "string",
                  "enum": ["early", "mid", "late", "any"]
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "consequences": {
                  "type": ["object", "null"]
                },
                "choices": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "text",
                      "outcome",
                      "hopeChange",
                      "trustChange",
                      "chaosChange",
                      "humanityChange"
                    ],
                    "properties": {
                      "id": { "type": "string", "minLength": 2 },
                      "text": { "type": "string", "minLength": 3 },
                      "outcome": { "type": "string", "minLength": 3 },
                      "hopeChange": { "type": "integer", "minimum": -30, "maximum": 30 },
                      "trustChange": { "type": "integer", "minimum": -30, "maximum": 30 },
                      "chaosChange": { "type": "integer", "minimum": -30, "maximum": 30 },
                      "humanityChange": { "type": "integer", "minimum": -30, "maximum": 30 },
                      "requiredRole": { "type": ["string", "null"] },
                      "roleBonus": { "type": ["object", "null"] }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
