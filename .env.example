# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Neon PostgreSQL connection string
# Get this from your Neon dashboard → Connection Details
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: scenario model and timeout tuning.
# OPENAI_SCENARIO_MODEL=gpt-4o-mini

# Optional: set to false to force seeded/fallback scenarios even when OPENAI_API_KEY is set.
# ENABLE_LIVE_AI_SCENARIOS=false

# Optional: OpenAI scenario timeout before seeded/fallback content is returned.
# OPENAI_SCENARIO_TIMEOUT_MS=20000

# Optional: set to true to allow seed-pack scenarios when live AI fails.
# ALLOW_SEEDED_SCENARIO_FALLBACK=false
